PORT=4000
# Comma-separated exact browser origins. Production frontend and API should share a site for SameSite=Strict cookies.
FRONTEND_URL=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vocabup
DB_USER=vocabup
DB_PASSWORD=vocabup
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
# Set to 1 only when exactly one trusted TLS reverse proxy is in front of Express.
TRUST_PROXY=0

